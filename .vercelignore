# server.js is the local-only server (SQLite in data/). If Vercel sees it, it deploys it as the
# app's backend, which crashes on Vercel's read-only filesystem. On Vercel, pages come from
# public/ and the API from api/index.js.
server.js
data/
scripts/
test/
# The System status page is for the local server only; it is not published on the live site.
public/status.html
public/js/status.js
src/status.js
